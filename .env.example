# Substrate - environment. Copy to .env. Never commit .env.
PORT=8080
SUBSTRATE_DB=substrate.db
# Optional: protect every genome except the public demo one
SUBSTRATE_API_KEY=

# Which brain to rent. Leave empty to auto-pick: anthropic if a key exists, else rule-core.
# Options: rule-core | anthropic | openai | ollama
SUBSTRATE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint: OpenAI, or on-prem vLLM / Ollama / BionicGPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Native Ollama (local, self-hosted)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
